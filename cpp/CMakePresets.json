{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-local",
      "displayName": "Windows x64 (MSVC + Ninja, Qt @ D:/Qt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.8.3/msvc2022_64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-local-release",
      "configurePreset": "windows-local",
      "configuration": "Release"
    }
  ]
}
